
import express from "express";
import dotenv from "dotenv";
import OpenAI from "openai";
import fs from "node:fs/promises";

dotenv.config();

const app = express();
const PORT = process.env.PORT || 3000;
const LAWS_FILE = new URL("./laws.json", import.meta.url);

app.use(express.json({ limit: "5mb" }));
app.use(express.static("public"));

const client = process.env.GEMINI_API_KEY
    ? new OpenAI({
        apiKey: process.env.GEMINI_API_KEY,
        baseURL: "https://generativelanguage.googleapis.com/v1beta/openai/"
    })
    : null;

const MODEL = process.env.OPENAI_MODEL || "gemini-3.1-flash-lite";

const instructions = `
Ты — RPM Attorney Assistant.
Ты анализируешь дела в вымышленной RP-юрисдикции RPM.

ОБЯЗАТЕЛЬНЫЕ ПРАВИЛА:

1. Используй только предоставленные законы RPM.
2. Не придумывай статьи и правовые нормы.
3. Если нужной нормы нет, прямо сообщи об этом.
4. Разделяй установленные факты и предположения.
5. Находи противоречия в показаниях и доказательствах.
6. Проверяй соблюдение процессуальных требований.
7. Указывай, каких доказательств не хватает.
8. Составляй конкретные и последовательные вопросы сотрудникам.
9. Не утверждай, что нарушение доказано без достаточных оснований.
10. При ссылке на закон указывай документ и номер статьи.

РЕЖИМЫ:

analyze:
Подробно проанализируй обстоятельства, доказательства,
возможные нарушения и позицию защиты.

followup:
Изучи ответ сотрудника, найди противоречия
и составь уточняющие вопросы.

Отвечай на русском языке.
Используй заголовки и структурированный формат.
Это инструмент для ролевой игры.
`;

function createMessages({ mode, caseData, laws, officerAnswer }) {
    return [
        {
            role: "system",
            content: instructions
        },
        {
            role: "user",
            content: `
РЕЖИМ:
${mode || "analyze"}

МАТЕРИАЛЫ ДЕЛА:
${caseData}

ЗАКОНЫ RPM:
${laws || "Законы не предоставлены."}

ОТВЕТ СОТРУДНИКА:
${officerAnswer || "Не предоставлен."}

Проведи анализ согласно инструкциям.
`
        }
    ];
}

// Загрузка законов
app.get("/api/laws", async (req, res) => {
    try {
        const data = await fs.readFile(LAWS_FILE, "utf8");
        res.json(JSON.parse(data));
    } catch (error) {
        console.error("Ошибка чтения законов:", error);
        res.status(500).json({
            error: "Не удалось загрузить базу законов."
        });
    }
});

// Сохранение законов
app.put("/api/laws", async (req, res) => {
    try {
        const data = req.body;

        if (!data || !Array.isArray(data.documents)) {
            return res.status(400).json({
                error: "Неверный формат базы законов."
            });
        }

        await fs.writeFile(
            LAWS_FILE,
            JSON.stringify(data, null, 2),
            "utf8"
        );

        res.json({
            success: true,
            message: "База законов сохранена."
        });
    } catch (error) {
        console.error("Ошибка сохранения законов:", error);
        res.status(500).json({
            error: "Не удалось сохранить базу законов."
        });
    }
});

// Проверка сервера
app.get("/api/health", (req, res) => {
    res.json({
        status: "ok",
        aiConfigured: Boolean(client),
        provider: "Google Gemini",
        model: MODEL
    });
});

// Обычный анализ — оставлен для совместимости
app.post("/api/attorney-assist", async (req, res) => {
    const startTime = Date.now();

    try {
        if (!client) {
            return res.status(503).json({
                error: "Gemini API-ключ не настроен. Проверь .env."
            });
        }

        const { caseData } = req.body;

        if (!caseData || !caseData.trim()) {
            return res.status(400).json({
                error: "Добавь описание дела."
            });
        }

        const response = await client.chat.completions.create({
            model: MODEL,
            messages: createMessages(req.body),
            max_tokens: 2500
        });

        const elapsed = ((Date.now() - startTime) / 1000).toFixed(2);

        res.json({
            result: response.choices?.[0]?.message?.content ||
                "Модель не вернула текстовый ответ.",
            elapsedSeconds: Number(elapsed)
        });

    } catch (error) {
        console.error("Ошибка Gemini:", error);

        res.status(500).json({
            error: "Ошибка Gemini API: " + error.message
        });
    }
});

// Потоковый анализ
app.post("/api/attorney-assist/stream", async (req, res) => {
    const startTime = Date.now();

    try {
        if (!client) {
            return res.status(503).json({
                error: "Gemini API-ключ не настроен. Проверь .env."
            });
        }

        const { caseData } = req.body;

        if (!caseData || !caseData.trim()) {
            return res.status(400).json({
                error: "Добавь описание дела."
            });
        }

        console.log("Начат потоковый запрос Gemini...");

        res.setHeader("Content-Type", "text/event-stream; charset=utf-8");
        res.setHeader("Cache-Control", "no-cache, no-transform");
        res.setHeader("Connection", "keep-alive");
        res.flushHeaders();

        const stream = await client.chat.completions.create({
            model: MODEL,
            messages: createMessages(req.body),
            max_tokens: 2500,
            stream: true
        });

        for await (const chunk of stream) {
            const content = chunk.choices?.[0]?.delta?.content;

            if (content) {
                res.write(`data: ${JSON.stringify({
                    type: "text",
                    content
                })}\n\n`);
            }

            if (res.destroyed) {
                break;
            }
        }

        if (!res.destroyed) {
            const elapsed = ((Date.now() - startTime) / 1000).toFixed(2);

            res.write(`data: ${JSON.stringify({
                type: "done",
                elapsedSeconds: Number(elapsed)
            })}\n\n`);

            res.end();

            console.log("Gemini завершил поток.");
            console.log("Время ответа:", elapsed, "секунд.");
        }

    } catch (error) {
        console.error("Ошибка потокового Gemini:", error);

        if (!res.headersSent) {
            return res.status(500).json({
                error: "Ошибка Gemini API: " + error.message
            });
        }

        if (!res.destroyed) {
            res.write(`data: ${JSON.stringify({
                type: "error",
                error: error.message
            })}\n\n`);

            res.end();
        }
    }
});

// Запуск
app.listen(PORT, () => {
    console.log("=================================");
    console.log("RPM Attorney Assistant запущен");
    console.log(`Адрес: http://localhost:${PORT}`);
    console.log("AI:", client ? "Gemini подключён" : "API-ключ не настроен");
    console.log("Модель:", MODEL);
    console.log("=================================");
});
